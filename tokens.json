{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "A warm, editorial community blog for a Bhutanese tech meetup — a clay-red accent over ink and warm paper, with a grotesque display face, a literary serif for reading, and a monospace for dates and labels.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.71,
          0.188,
          0.122
        ],
        "hex": "#b5301f"
      }
    },
    "onPrimary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "primarySoft": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.965,
          0.89,
          0.875
        ],
        "hex": "#f6e3df"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.788,
          0.604,
          0.227
        ],
        "hex": "#c99a3a"
      }
    },
    "background": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.949,
          0.953,
          0.941
        ],
        "hex": "#f2f3f0"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.984,
          0.984,
          0.976
        ],
        "hex": "#fbfbf9"
      }
    },
    "text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.09,
          0.102,
          0.122
        ],
        "hex": "#171a1f"
      }
    },
    "textSecondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.294,
          0.322,
          0.361
        ],
        "hex": "#4b525c"
      }
    },
    "textMuted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.486,
          0.514,
          0.549
        ],
        "hex": "#7c838c"
      }
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.851,
          0.863,
          0.847
        ],
        "hex": "#d9dcd8"
      }
    },
    "borderSubtle": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.906,
          0.914,
          0.898
        ],
        "hex": "#e7e9e5"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 28,
        "unit": "px"
      }
    },
    "section": {
      "$value": {
        "value": 56,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 14,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "pill": {
      "$value": {
        "value": 999,
        "unit": "px"
      }
    }
  },
  "typography": {
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Bricolage Grotesque",
        "fontSize": {
          "value": 68,
          "unit": "px"
        },
        "fontWeight": 800,
        "letterSpacing": {
          "value": -0.03,
          "unit": "em"
        }
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Bricolage Grotesque",
        "fontSize": {
          "value": 28,
          "unit": "px"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": -0.01,
          "unit": "em"
        }
      }
    },
    "h3": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Bricolage Grotesque",
        "fontSize": {
          "value": 22,
          "unit": "px"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": -0.02,
          "unit": "em"
        }
      }
    },
    "bodyMd": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Newsreader",
        "fontSize": {
          "value": 18,
          "unit": "px"
        },
        "fontWeight": 400
      }
    },
    "lede": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Newsreader",
        "fontSize": {
          "value": 21,
          "unit": "px"
        },
        "fontWeight": 400
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "IBM Plex Mono",
        "fontSize": {
          "value": 12,
          "unit": "px"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0.04,
          "unit": "em"
        }
      }
    },
    "eyebrow": {
      "$type": "typography",
      "$value": {
        "fontFamily": "IBM Plex Mono",
        "fontSize": {
          "value": 12,
          "unit": "px"
        },
        "fontWeight": 500,
        "letterSpacing": {
          "value": 0.08,
          "unit": "em"
        }
      }
    }
  }
}
